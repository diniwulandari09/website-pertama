node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Build Output
dist/
build/
*.min.js
*.min.css

# Temporary Files
*.tmp
*.temp
.cache/

# OS
.DS_Store
.env.local
thumbs.db

# Logs
*.log
logs/

